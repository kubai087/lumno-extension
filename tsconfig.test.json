{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome",
      "vite/client",
      "vitest/globals"
    ]
  },
  "exclude": [
    "tests/helpers/**"
  ],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.mjs",
    "vite.overlay.config.mjs",
    "vitest.config.ts",
    "src/types/**/*.d.ts"
  ]
}
