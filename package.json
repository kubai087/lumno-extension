{
  "name": "lumno-extension",
  "version": "1.2.1",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:static && npm run build:entries",
    "build:entries": "node scripts/build/build.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run --config vitest.config.ts --project domain --project platform --project dom --project repo",
    "verify": "npm test && npm run check:static",
    "test:e2e": "vitest run --config vitest.config.ts --project e2e",
    "check": "npm run build && npm run check:static",
    "check:static": "npm run check:no-js && npm run check:js && npm run check:locales && npm run typecheck && npm run check:manifest && npm run lint",
    "check:no-js": "node scripts/check/check-no-js.js",
    "check:js": "node scripts/check/check-js-syntax.js",
    "check:locales": "node scripts/check/check-locales.js",
    "check:locales:strict": "node scripts/check/check-locales.js --strict",
    "i18n:export": "node scripts/i18n/export-chunks.js",
    "i18n:import": "node scripts/i18n/import-chunks.js",
    "check:manifest": "node scripts/check/check-manifest-resources.js",
    "lint": "eslint .",
    "audit:style": "node scripts/check/audit-style-debt.js",
    "audit:i18n": "node scripts/check/audit-i18n.js",
    "profile:newtab-data": "node --expose-gc scripts/dev/profile-newtab-data-performance.js",
    "profile:gates": "node scripts/dev/profile-page-gates.js",
    "e2e:shortcut-groups": "node scripts/dev/e2e-newtab-shortcut-groups.js",
    "smoke": "npm run build && vitest run --config vitest.config.ts --project e2e tests/e2e/surfaces.test.ts",
    "cleanup:browsers": "node scripts/dev/cleanup-test-browsers.js",
    "package:store": "npm run check:locales:strict && npm run build && node scripts/build/package-store.js",
    "package:firefox": "npm run package:store && node scripts/build/build-firefox.js",
    "lint:firefox": "npx --yes web-ext@latest lint -s dist/firefox",
    "build:static": "node scripts/build/build-static.js",
    "watch": "node scripts/build/watch.js"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "pinyin-pro": "3.29.5",
    "react": "^19.2.9",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "rolldown": "^1.2.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
