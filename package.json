{
  "name": "lumno-extension",
  "version": "1.1.4",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:react && npm run build:bundles",
    "build:react": "vite build --config react-src/vite.config.mjs && vite build --config react-src/vite.overlay.config.mjs",
    "build:bundles": "node scripts/build/build-bundles.js",
    "watch:bundles": "node scripts/build/build-bundles.js --watch",
    "typecheck:react": "tsc --project react-src/tsconfig.json --noEmit",
    "test": "npm run build && npm run test:legacy && npm run test:react",
    "verify": "npm test && npm run check:static",
    "test:legacy": "node tests/run-tests.js",
    "test:react": "vitest run --config react-src/vitest.config.ts",
    "check": "npm run build && npm run check:static",
    "check:static": "npm run check:js && npm run check:names && npm run check:locales && npm run check:bookmarks && npm run typecheck:react && npm run check:react-bundle && npm run check:manifest && npm run lint",
    "check:bookmarks": "node --check src/newtab/bookmarks/bookmarks-runtime.js && node --check src/newtab/bookmarks/bookmark-cascade-menu.js",
    "check:react-bundle": "node --check src/react/newtab-islands.js && node --check src/react/options-islands.js && node --check src/react/onboarding-islands.js && node --check src/react/overlay-islands.js && node --check src/react/popup-islands.js && node --check src/react/react-shared.js && node --check src/react/tab-switcher-shared.js && node --check src/react/react-runtime.js && node --check src/react/rolldown-runtime.js",
    "check:js": "node scripts/check/check-js-syntax.js",
    "check:names": "node scripts/check/check-undefined-names.js",
    "check:locales": "node scripts/check/check-locales.js",
    "i18n:export": "node scripts/i18n/export-chunks.js",
    "i18n:import": "node scripts/i18n/import-chunks.js",
    "check:manifest": "node scripts/check/check-manifest-resources.js",
    "lint": "eslint .",
    "audit:style": "node scripts/check/audit-style-debt.js",
    "audit:i18n": "node scripts/check/audit-i18n.js",
    "profile:newtab-data": "node --expose-gc scripts/dev/profile-newtab-data-performance.js",
    "e2e:shortcut-groups": "node scripts/dev/e2e-newtab-shortcut-groups.js",
    "smoke": "npm run build:bundles && node scripts/dev/smoke-extension.js",
    "cleanup:browsers": "node scripts/dev/cleanup-test-browsers.js",
    "package:store": "npm run build:react && node scripts/build/package-store.js",
    "package:firefox": "npm run package:store && node scripts/build/build-firefox.js",
    "lint:firefox": "npx --yes web-ext@latest lint -s dist/firefox"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "react": "^19.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
