{
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_ext_name__"
  },
  "background": {
    "service_worker": "build/background.js"
  },
  "commands": {
    "show-search": {
      "description": "__MSG_command_show_search__",
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    },
    "show-search-prefill": {
      "description": "__MSG_command_show_search_prefill__",
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    },
    "show-search-prefill-v": {
      "description": "__MSG_command_show_search_prefill_v__",
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      }
    },
    "show-tab-switcher": {
      "description": "__MSG_command_show_tab_switcher__",
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      }
    },
    "show-tab-switcher-reverse": {
      "description": "__MSG_command_show_tab_switcher_reverse__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "build/shortcut-key-observer.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.iqiyi.com/*",
        "*://*.iq.com/*",
        "*://*.kuaishou.com/*",
        "*://*.kwai.com/*",
        "*://*.netflix.com/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.in/*",
        "*://*.disneyplus.com/*",
        "*://*.hotstar.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.tiktok.com/*",
        "*://*.tubitv.com/*",
        "*://*.pluto.tv/*",
        "*://*.twitch.tv/*",
        "*://*.douyin.com/*",
        "*://*.youku.com/*",
        "*://*.v.qq.com/*",
        "*://*.bilibili.com/*",
        "*://*.bilibili.tv/*"
      ],
      "js": [
        "build/site-auto-pip.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "build/youtube-auto-pip.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "__MSG_ext_description__",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/images/lumno.png",
    "48": "assets/images/lumno.png",
    "128": "assets/images/lumno.png"
  },
  "key": "",
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/lumno.png",
        "assets/images/lumno-selection-mark.svg",
        "assets/images/lumno-wordmark.svg",
        "assets/images/lumno-wordmark-dark.svg",
        "assets/images/lumno-wordmark-mask.svg",
        "assets/images/site-search/*.png",
        "assets/data/site-search.json",
        "assets/data/shortcut-rules.json",
        "build/pinyin.js",
        "build/han-variants.js",
        "build/injected/*",
        "assets/remixicon/fonts/remixicon.css",
        "assets/remixicon/fonts/remixicon.woff2",
        "assets/remixicon/icons/*.svg",
        "assets/fonts/open-sans/open-sans.css",
        "assets/fonts/open-sans/OpenSans-VariableFont-wdth-wght.woff2",
        "_locales/en/messages.json",
        "_locales/ja/messages.json",
        "_locales/zh_CN/messages.json",
        "_locales/zh_TW/messages.json",
        "src/shared/search/search-input.css",
        "src/shared/ui/menu-surface.css",
        "src/shared/ui/feature-hints.css",
        "src/shared/ui/tooltip.css",
        "src/shared/ui/cursor-tooltip.css",
        "src/shared/ui/toast.css",
        "src/shared/ui/external-link-icon.css",
        "src/overlay/suggestions-view.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_ext_name__",
  "author": "Kubai087",
  "permissions": [
    "scripting",
    "tabs",
    "tabGroups",
    "history",
    "topSites",
    "bookmarks",
    "storage",
    "search",
    "favicon",
    "alarms",
    "unlimitedStorage",
    "contextMenus",
    "fontSettings",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "version": "1.3.0"
}
